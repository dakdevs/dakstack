{
  "name": "dakstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dakstack-mcp": "./mcp/dakstack-mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "mcp/",
    "skills/",
    "licenses/",
    "CREDITS.md"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings . && bun run verify:upstream && bun run verify:review-policy",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun test",
    "test:e2e": "bun test tests/installed-stack.test.ts tests/local-mcp.test.ts",
    "verify:upstream": "bun scripts/verify-upstream.ts",
    "verify:review-policy": "bun scripts/verify-review-policy.ts"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
